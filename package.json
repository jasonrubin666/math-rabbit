{
  "name": "math-rabbit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "deploy": "npm run build && rm -rf docs/v2 && cp -R dist docs/v2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource/knewave": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0"
  }
}
